# Proveedor preferido por tarea: ollama (local) | gemini (API de Google)
# /analizar-parcela cae a Ollama si Gemini falla o no hay internet
PROVEEDOR_ANALISIS=gemini
PROVEEDOR_EXPLICAR=ollama
# /preguntar (preguntas por voz)
PROVEEDOR_PREGUNTAR=gemini
# /traducir-zapoteco (experimental)
PROVEEDOR_TRADUCIR=gemini
# /analizar-cultivo: Gemini y local al mismo tiempo, gana el primero (más rápido)
CULTIVO_EN_PARALELO=true

# Ollama local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=120

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT=30

PORT=8000
